<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 1. Anel Orbital da Geometria Sagrada (Estilo HUD tecnológico de fundo) -->
    <path
        android:strokeColor="#00E5FF"
        android:strokeWidth="0.8"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:strokeAlpha="0.35"
        android:pathData="M 54,28 a 26,26 0 1,0 0,52 a 26,26 0 1,0 0,-52" />

    <!-- 2. Pequenos Nós de Detalhe Tecnológico ao redor do Anel -->
    <path android:fillColor="#00E5FF" android:fillAlpha="0.5" android:pathData="M 54,26.5 a 1.5,1.5 0 1,0 0,3 a 1.5,1.5 0 1,0 0,-3" />
    <path android:fillColor="#00E5FF" android:fillAlpha="0.5" android:pathData="M 80,52.5 a 1.5,1.5 0 1,0 0,3 a 1.5,1.5 0 1,0 0,-3" />
    <path android:fillColor="#00E5FF" android:fillAlpha="0.5" android:pathData="M 54,78.5 a 1.5,1.5 0 1,0 0,3 a 1.5,1.5 0 1,0 0,-3" />
    <path android:fillColor="#00E5FF" android:fillAlpha="0.5" android:pathData="M 28,52.5 a 1.5,1.5 0 1,0 0,3 a 1.5,1.5 0 1,0 0,-3" />

    <!-- 3. Estrela de Quatro Folhas (Geometria Sagrada da Castanha) -->
    <!-- Todos os quatro losangos agrupados para receber um degradê único e contínuo -->
    <path android:pathData="
        M 54,51 L 44,28 L 54,18 L 64,28 Z 
        M 54,57 L 44,80 L 54,90 L 64,80 Z 
        M 51,54 L 28,44 L 18,54 L 28,64 Z 
        M 57,54 L 80,44 L 90,54 L 80,64 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="38"
                android:type="radial">
                <!-- O centro brilha em Verde-Teal (Pix) e as pontas irradiam em Ciano Elétrico -->
                <item android:offset="0.0" android:color="#3DDC84" />
                <item android:offset="0.5" android:color="#00E5FF" />
                <item android:offset="1.0" android:color="#00838F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 4. Sutil Linha de Contorno Brilhante para destacar as folhas -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.4"
        android:pathData="
            M 54,51 L 44,28 L 54,18 L 64,28 Z 
            M 54,57 L 44,80 L 54,90 L 64,80 Z 
            M 51,54 L 28,44 L 18,54 L 28,64 Z 
            M 57,54 L 80,44 L 90,54 L 80,64 Z" />

</vector>
